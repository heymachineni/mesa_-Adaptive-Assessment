# Copy to .env and change the two credentials below before anyone real signs in.
# .env is gitignored — it never reaches GitHub.

# Guards every /admin page and the results export. It travels in the URL
# as ?key=…, so don't screen-share the admin tab.
ADMIN_KEY=mesa-admin-dev

# Password given to every account seed.py creates. Change, then re-seed.
DEFAULT_STUDENT_PASSWORD=mesa-demo-2026

PORT=8000

# Where mesa.db is written. Defaults to the folder holding seed.py.
# Point this at a mounted volume in production.
# DB_DIR=/data

# Browser-level proctoring: log when a student leaves the exam window.
# Works in every browser, needs no install. A deterrent + audit trail, not lockdown.
PROCTOR_FOCUS=on
