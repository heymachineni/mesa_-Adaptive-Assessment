ADMIN_KEY=mesa-admin-dev
PORT=8000
DEFAULT_STUDENT_PASSWORD=mesa-demo-2026

# Browser-level proctoring: log when a student leaves the exam window.
# Works in every browser, needs no install. A deterrent + audit trail, not lockdown.
PROCTOR_FOCUS=on

# --- Safe Exam Browser (optional) ---
# off | detect | enforce
SEB_MODE=off
# Paste from SEB Config Tool (Exam tab) after loading mesa_exam.seb:
SEB_BROWSER_EXAM_KEY=
SEB_CONFIG_KEY=
# Password required to quit SEB (leave empty while testing!)
SEB_QUIT_PASSWORD=
